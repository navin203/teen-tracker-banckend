# ==============================================================================
# TeenTrack – Root Environment Configuration Reference (.env.example)
# ==============================================================================
# Note: For security and strict decoupling, the frontend and backend have their
# own isolated .env files:
#
#   - frontend/.env : Safe client-side variables (prefixed with VITE_)
#   - backend/.env  : Sensitive server-side secrets (NEVER expose to browser)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (Safe for client, used by server to initialize client SDK)
SUPABASE_ANON_KEY=eyJhbGciOi...

# CRITICAL SECURITY NOTE:
# The service-role key bypasses Row Level Security (RLS).
# Keep this strictly in backend/.env ONLY. NEVER put this in frontend/.env or client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Allowed Frontend Origins for CORS (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------
# Supabase URL and Anon Key (safe for public browser client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend REST API Base URL
VITE_API_URL=http://localhost:5000
